abstract class Animal {
    abstract void walk();

    Animal() {
        System.out.println("calling animal constructor");
    }
}

class Horse extends Animal {
    public void walk() {
        System.out.println("walks on 4 legs");
    }

    Horse() {
        System.out.println("calling horse constructor");
    }
}

class Chicken extends Animal {
    public void walk() {
        System.out.println("walks on 2 legs");
    }
}

public class OOPS {
    public static void main(String args[]) {
        Horse horse = new Horse();              // constructor chaining // first, constructor of based class will be called // then called constructor of derived class
